{
  "uid": "fleet-health",
  "title": "fleet health // infrastructure",
  "description": "Live host vitals for the whole fleet \u2014 CPU, RAM, disk and load, straight from each node's /proc via the aggregator. No agent, no exporter: this is the liveness-and-capacity view (which box is about to fill its disk), not a history/trend view. For history and alert rules, Grafana Alloy + remote_write is the next step. Switch the node dropdown to see one box on its own.",
  "tags": [
    "infra",
    "fleet",
    "vitals"
  ],
  "timezone": "browser",
  "editable": true,
  "refresh": "1m",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "schemaVersion": 39,
  "version": 0,
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "nodes reporting",
      "description": "how many nodes answered. Anything below the fleet size means a dashboard service is down \u2014 the aggregator names the missing node in the API response.",
